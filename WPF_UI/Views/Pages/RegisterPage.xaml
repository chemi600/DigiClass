<Page
    x:Class="Wpf.Ui.Demo.Mvvm.Views.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Wpf.Ui.Demo.Mvvm.Helpers"
    xmlns:local="clr-namespace:Wpf.Ui.Demo.Mvvm.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LoginPage"
    d:DataContext="{d:DesignInstance local:LoginPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    

    <StackPanel Margin="42">
        <ui:TextBlock
            FontSize="20"
            FontWeight="Medium"
            Text="Registro"
           
            HorizontalAlignment="Center"/>

        <TextBlock Text="Nombre de Usuario"
                   Foreground="DarkGray"
                   FontSize="12"
                   FontWeight="Medium"
                   Margin="0,15,0,0"
                   Width="300">
            
        </TextBlock>
        
        <TextBox x:Name="user"
                 FontSize="13"
                 FontWeight="Medium"
                 Background="Transparent"
                 
                 CaretBrush="LightGray"
                 BorderBrush="DarkGray"
                 BorderThickness="0,0,0,2"
                 Width="300"
                 Text="{Binding ViewModel.TxtUser,Mode=TwoWay}"
                 VerticalAlignment="Center"
                 Margin="0,5,0,0">
            
            
        </TextBox>

        <TextBlock Text="Email"
           Foreground="DarkGray"
           FontSize="12"
           FontWeight="Medium"
           Margin="0,15,0,0"
           Width="300">

        </TextBlock>

        <TextBox x:Name="email"
         FontSize="13"
         FontWeight="Medium"
         Background="Transparent"
         
         CaretBrush="LightGray"
         BorderBrush="DarkGray"
         BorderThickness="0,0,0,2"
         Width="300"
         Text="{Binding ViewModel.TxtEmail,Mode=TwoWay}"
         VerticalAlignment="Center"
         Margin="0,5,0,0">


        </TextBox>

        <TextBlock Text="Contraseña"
   Foreground="DarkGray"
   FontSize="12"
   FontWeight="Medium"
   Margin="0,15,0,0"
   Width="300">

        </TextBlock>

        <ui:PasswordBox x:Name="password"
     FontSize="13"
     FontWeight="Medium"
     Background="Transparent"
    
     CaretBrush="LightGray"
     BorderBrush="DarkGray"
     BorderThickness="0,0,0,2"
     Width="300"
     Password="{Binding ViewModel.TxtPassword,Mode=TwoWay}"
     VerticalAlignment="Center"
     Margin="0,5,0,0">  


        </ui:PasswordBox>

        <TextBlock Text="Confirma la contraseña"
   Foreground="DarkGray"
   FontSize="12"
   FontWeight="Medium"
   Margin="0,15,0,0"
   Width="300">

        </TextBlock>

        <ui:PasswordBox x:Name="ConfirmPassword"
     FontSize="13"
     FontWeight="Medium"
     Background="Transparent"
     
     CaretBrush="LightGray"
     BorderBrush="DarkGray"
     BorderThickness="0,0,0,2"
     Width="300"
        Password="{Binding ViewModel.TxtRepeatPassword,Mode=TwoWay}"
     VerticalAlignment="Center"
     Margin="0,5,0,0">


        </ui:PasswordBox>



        <ui:Button
            Margin="20"
            Grid.Column="0"
            Content="Registrarse"
            HorizontalAlignment="Center"
            Command="{Binding ViewModel.clickRegisterCommand,Mode=OneWay}"/>  



    </StackPanel>
</Page>
