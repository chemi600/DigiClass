<Page
    x:Class="Wpf.Ui.Demo.Mvvm.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Demo.Mvvm.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>




        <StackPanel Margin="12" HorizontalAlignment="Center" Width="400">
            <ui:TextBlock
         FontSize="20"
         FontWeight="Medium"
         Text="Personaje"
        
         HorizontalAlignment="Center"/>

            <TextBlock Text="Nombre"
                Foreground="DarkGray"
                FontSize="12"
                FontWeight="Medium"
                Margin="0,15,0,0"
                Width="300">

            </TextBlock>

            <TextBox x:Name="name"
              FontSize="13"
              FontWeight="Medium"
              Background="Transparent"
              
              CaretBrush="LightGray"
              BorderBrush="DarkGray"
              BorderThickness="0,0,0,2"
              Width="300"
              Text="{Binding ViewModel.Nombre,Mode=TwoWay}"
              VerticalAlignment="Center"
              Margin="0,5,0,0">


            </TextBox>

            <TextBlock Text="Damage"
        Foreground="DarkGray"
        FontSize="12"
        FontWeight="Medium"
        Margin="0,15,0,0"
        Width="300">

            </TextBlock>

            <ui:NumberBox x:Name="damage"
      FontSize="13"
      FontWeight="Medium"
      Background="Transparent"
      
      CaretBrush="LightGray"
      BorderBrush="DarkGray"
      BorderThickness="0,0,0,2"
      Width="300"
      Text="{Binding ViewModel.Damage,Mode=TwoWay}"
      VerticalAlignment="Center"
      Margin="0,5,0,0">


            </ui:NumberBox>

            <TextBlock Text="Clase"
Foreground="DarkGray"
FontSize="12"
FontWeight="Medium"
Margin="0,15,0,0"
Width="300">

            </TextBlock>

            <ui:TextBox x:Name="class"
  FontSize="13"
  FontWeight="Medium"
  Background="Transparent"
 
  CaretBrush="LightGray"
  BorderBrush="DarkGray"
  BorderThickness="0,0,0,2"
  Width="300"
  Text="{Binding ViewModel.Clase,Mode=TwoWay}"
  VerticalAlignment="Center"
  Margin="0,5,0,0">


            </ui:TextBox>
            <ui:Button
                Margin="20"
                Grid.Column="0"
                Content="Enviar"
                HorizontalAlignment="Center"
                Command="{Binding ViewModel.enviarCommand, Mode=OneWay}"/>

        </StackPanel>
    </Grid>
</Page>
