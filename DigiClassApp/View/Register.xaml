<UserControl x:Class="DigiClass.View.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DigiClass.View"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewmodels="clr-namespace:DigiClass.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodels:RegisterViewModel}"
        mc:Ignorable="d"
             Background="White"
        Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="auto" Height="auto">
            <Label Content="Nombre"/>

            <ui:TextBox Width="300" Height="25" Text="{Binding Name,Mode=TwoWay}"/>

            <Label Content="Correo"/>

            <ui:TextBox Width="300" Height="25" Text="{Binding Correo,Mode=TwoWay}"/>

            <Label Content="Contraseña"/>

            <ui:PasswordBox Height="25" Password="{Binding Password,Mode=TwoWay}"/>

            <Label Content="Repite la Contraseña"/>

            <ui:PasswordBox Height="25" Password="{Binding PasswordRepeat,Mode=TwoWay}"/>




            <ui:Button Content="Registrarse" Margin="20" Command="{Binding RegistrarseCommand}"/>
        </StackPanel>

        <ui:Button Content="Volver al login" Margin="44,358,556,52" Width="200" Height="40" Command="{Binding BackCommand}"/>
    </Grid>
</UserControl>
