<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\DigiClassWhithe.png" />
    <None Remove="Resources\edificio.jpg" />
    <None Remove="Resources\IconComercio.png" />
    <None Remove="Resources\Instituto.jpg" />
    <None Remove="Resources\logo_digi.png" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.1" />
		<PackageReference Include="WPF-UI" Version="3.0.5" />
		<PackageReference Include="WPF-UI.Tray" Version="3.0.4" />
		<PackageReference Include="WPF-UI.Abstractions" Version="4.0.0-rc.3" />
		<PackageReference Include="WPF-UI.DependencyInjection" Version="4.0.0-rc.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\DigiClassWhithe.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\edificio.jpg">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\IconComercio.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\Instituto.jpg">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Resources\logo_digi.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resource1.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resource1.resx</DependentUpon>
	  </Compile>
	  <Compile Update="View\Dashboard.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="View\ProductView.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="View\ProductListView.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="View\Home.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="View\Register.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resource1.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resource1.Designer.cs</LastGenOutput>
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Page Update="View\Dashboard.xaml">
	    <SubType>Designer</SubType>
	  </Page>
	</ItemGroup>
	
</Project>
