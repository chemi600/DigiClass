<UserControl x:Class="InfoManager.View.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:InfoManager.View"
        Background="White"
             xmlns:viewmodels="clr-namespace:InfoManager.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
        Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="auto" Height="auto">
            <Label Content="Correo Electronico"/>
            
            <ui:TextBox Width="300" Height="25" Text="{Binding Name}"/>
            
            <Label Content="Contraseña"/>
            
            <ui:PasswordBox Height="25" Password="{Binding Password,Mode=TwoWay}"/>
            
            <ui:TextBlock
                Foreground="#4A90E2" 
                Cursor="Hand" 
                VerticalAlignment="Center">
                
                <Hyperlink Command="{Binding RegisterCommand}">
                    <Run Text="Regístrate aquí" />
                </Hyperlink>
                
            </ui:TextBlock>
            
            <ui:Button Content="Enviar" Margin="20" Command="{Binding LoginCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
