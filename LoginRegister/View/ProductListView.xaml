<UserControl x:Class="InfoManager.View.ProductListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:InfoManager.View"
        Background="White"
             xmlns:viewmodels="clr-namespace:InfoManager.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ProductListViewModel}"
        Height="450" Width="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Filtro" HorizontalAlignment="Center" Grid.Row="0"/>
        <ui:TextBox PlaceholderText="Filtro" Width="300" Height="25" Grid.Row="1" Text="{Binding Filtro,Mode=TwoWay}"/>
        <ui:Button Content="Buscar" Grid.Row="1" Width="40" Margin="376,0,0,0" Command="{Binding FilterCommand}"/>
        <ui:Button Grid.Row="1" Width="60" HorizontalAlignment="Right" Content="Recargar"/>
        <ScrollViewer Grid.Row="2">
            <DataGrid 
    Grid.Row="1"
     Grid.ColumnSpan="2"       
    x:Name="MyDataGrid"       
    ItemsSource="{Binding Items,Mode=TwoWay}" 
    AutoGenerateColumns="False" 
    Margin="10" 
    CanUserResizeColumns="True"
    CanUserResizeRows="False"
    CanUserAddRows="False"
    VerticalAlignment="Top"
    HorizontalAlignment="Center"
    MinRowHeight="25"
    MaxHeight="400" 
    ColumnWidth="Auto"
    ScrollViewer.VerticalScrollBarVisibility="Auto"
    ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding id}" />
                    <DataGridTextColumn Header="Titulo" Binding="{Binding titulo}" />
                    <DataGridTextColumn Header="Descripcion" Binding="{Binding descripcion}"/>
                    <DataGridTextColumn Header="Prodesor" Binding="{Binding nombreProfesor}"/>
                    <DataGridTextColumn Header="Fecha de Inicio" Binding="{Binding fechaInicio}"/>
                    <DataGridTextColumn Header="Fecha de fin" Binding="{Binding fechaFin}"/>

                    <DataGridTemplateColumn Header="Acciones">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Eliminar" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>

    </Grid>
</UserControl>
